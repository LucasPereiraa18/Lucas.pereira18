# Public browser-safe Supabase values. Do not place service_role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only AES-256-GCM key. Generate with: node scripts/generate-encryption-key.mjs
SECULLUM_ENCRYPTION_KEY=
